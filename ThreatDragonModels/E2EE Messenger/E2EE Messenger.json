              "privilegeLevel": "",
              "threats": [
                {
                  "id": "17d90b0e-6ac0-43cf-a956-01962b84d36c",
                  "title": "User denies sending a message",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Repudiation",
                  "description": "A sender disputes authorship, and the server cannot prove it. Rating: likelihood 1 x impact 1 = 1 (Low). Likelihood 1: rare in a private messenger. Impact 1: deniability is a Signal design feature.",
                  "mitigation": "Document as accepted residual risk.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                },
                {
                  "id": "cc1590d2-1a2b-4c5d-b508-5156740557ef",
                  "title": "Server learns who talks to whom, when and how often",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Traffic metadata is visible to the server and its operator. Rating: likelihood 3 x impact 2 = 6 (High). Likelihood 3: the server always sees routing data. Impact 2: no content, but social graph exposed.",
                  "mitigation": "Minimize logging and retention, document as accepted residual risk, and consider sealed sender.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "0e63796b-7273-43bd-bdb7-954838882c62",
                  "title": "WebSocket flooding and message spam",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker opens many connections or sends floods to exhaust the server. Rating: likelihood 3 x impact 1 = 3 (Medium). Likelihood 3: trivial to attempt. Impact 1: temporary degradation.",
                  "mitigation": "Rate limiting, authentication before connection, and connection caps.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                }
              ]
            }

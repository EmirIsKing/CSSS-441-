              "name": "Ciphertext send and receive",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isBidirectional": true,
              "isEncrypted": true,
              "isPublicNetwork": false,
              "protocol": "",
              "threats": [
                {
                  "id": "ce386a6c-3aa8-40bd-aa0f-6d7af2072352",
                  "title": "Ciphertext modified in transit or at rest",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "An attacker or the server alters stored or relayed ciphertext. Rating: likelihood 1 x impact 2 = 2 (Low). Likelihood 1: TLS 1.3 plus AEAD make undetected change very hard. Impact 2: message is lost or corrupted, not read.",
                  "mitigation": "AEAD authentication in the Signal Protocol, TLS 1.3, and tampered-ciphertext tests.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "6cafd6cd-64a8-4983-b91b-ebdea4fbea20",
                  "title": "Replay or reordering of messages",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "An attacker resends or reorders captured messages over the WebSocket. Rating: likelihood 2 x impact 2 = 4 (Medium). Likelihood 2: network position is needed but easy once held. Impact 2: confusing or duplicated messages.",
                  "mitigation": "Double Ratchet message counters, reject duplicates, TLS 1.3.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "11280711-44cd-4f59-a80c-732aec3bb516",
                  "title": "Remote session reset abused to desync or downgrade",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "An attacker triggers or forges a session reset to break sessions or force re-keying. Rating: likelihood 1 x impact 2 = 2 (Low). Likelihood 1: reset requests require authentication. Impact 2: denial of a chat, not disclosure.",
                  "mitigation": "Authenticate reset requests, rate-limit them, and re-verify keys after a reset.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
              ]
            },

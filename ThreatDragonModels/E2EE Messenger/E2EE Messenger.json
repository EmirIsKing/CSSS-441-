              "threats": [
                {
                  "id": "fc0e87d5-0dc9-4ce8-b7f0-c659f6aaf928",
                  "title": "Attacker registers as another user",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Registration of an existing identifier without proof of ownership. Rating: likelihood 2 x impact 2 = 4 (Medium). Likelihood 2: depends on registration checks. Impact 2: contacts may message the wrong party until verified.",
                  "mitigation": "Verified registration, one identity per account, and key verification between users.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 14,
                  "score": ""
                },
                {
                  "id": "77b5e66e-e2e5-4a1b-9343-d3c675e59e83",
                  "title": "Prekey exhaustion",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "An attacker drains a victim's one-time prekeys by repeated fetches. Rating: likelihood 3 x impact 2 = 6 (High). Likelihood 3: unauthenticated fetches are easy to script. Impact 2: sessions fall back to weaker prekey use.",
                  "mitigation": "Authenticate and rate-limit fetches, add last-resort prekeys, and replenish automatically.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 15,
                  "score": ""
                }
              ]
            }

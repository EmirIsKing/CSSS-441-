              "threats": [
                {
                  "id": "448209a3-4731-4f36-bc21-b07eebdac097",
                  "title": "Local user impersonation on an unlocked device",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Someone with physical access opens the app and sends messages as the user. Rating: likelihood 2 x impact 2 = 4 (Medium). Likelihood 2: phones are lost or borrowed. Impact 2: limited to one account until noticed.",
                  "mitigation": "App lock (biometric or PIN) and auto-lock timeout.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "da768035-8929-4d82-9e31-c9ae9d23f956",
                  "title": "Key-change warning ignored by user",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "A contact's identity key changes and the user clicks through the warning, accepting an attacker's key. Rating: likelihood 2 x impact 2 = 4 (Medium). Likelihood 2: users habitually dismiss warnings. Impact 2: one conversation exposed.",
                  "mitigation": "Blocking warning, safety-number re-verification prompt, and a clear key-changed marker in the chat.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ]

              "isTrustBoundary": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "133728a1-956a-4d9f-9424-17bf4850d07c",
                  "title": "Plaintext leaks via logs, notifications or backups",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Message text ends up in logs, push payloads or device backups. Rating: likelihood 2 x impact 3 = 6 (High). Likelihood 2: common developer mistake. Impact 3: bypasses all encryption.",
                  "mitigation": "No content in push payloads, log scrubbing, exclude the database from backups, and grep dumps for plaintext in tests.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 16,
                  "score": ""
                },
                {
                  "id": "8c956216-38b0-433e-a8d5-11eb6d7fbb7a",
                  "title": "Compromised identity key allows impersonation",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "description": "A stolen identity key lets an attacker act as the user and sign prekeys. Rating: likelihood 1 x impact 3 = 3 (Medium). Likelihood 1: key is stored in hardware-backed storage. Impact 3: full account impersonation.",
                  "mitigation": "Keystore or non-extractable keys, re-registration with a visible key-change warning to contacts.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 17,
                  "score": ""
                },
                {
                  "id": "af11ed9a-180e-4626-abee-334d0c4920bb",
                  "title": "Disappearing messages bypassed",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Information disclosure",
                  "description": "Screenshots, backups or forwarding keep messages past their timer. Rating: likelihood 2 x impact 1 = 2 (Low). Likelihood 2: easy for a recipient. Impact 1: limited to messages the recipient already saw.",
                  "mitigation": "Honor timers locally, block screenshots where possible, and state the limit in the report.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 18,
                  "score": ""
                }
              ]
            }
          },

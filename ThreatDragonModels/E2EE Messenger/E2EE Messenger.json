                {
                  "id": "45ce6189-9285-464e-ba9f-0921170a30e6",
                  "title": "Key server swaps a contact's identity key (MITM)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "A malicious or compromised key server returns attacker keys in a prekey bundle. Rating: likelihood 2 x impact 3 = 6 (High). Likelihood 2: the server is untrusted by design. Impact 3: full loss of confidentiality for that chat.",
                  "mitigation": "Safety-number or QR verification, key-change warning, and key transparency as a stretch goal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "862ab636-8c06-4d83-9ed3-eed54d6ca72b",
                  "title": "Forged or malformed prekeys uploaded",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "An attacker uploads bad signed prekeys for a victim account. Rating: likelihood 1 x impact 3 = 3 (Medium). Likelihood 1: upload needs authentication. Impact 3: poisons future sessions.",
                  "mitigation": "Authenticate uploads, verify prekey signatures against the identity key, and validate formats.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                }
